# IngrAIent Backend Environment Variables (Template)
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Copy this file to backend/.env and add your actual API key below.
GEMINI_API_KEY=

# Gemini Model Selection (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Port for Backend Service
PORT=4000
